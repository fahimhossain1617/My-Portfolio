# ==============================================================================
# MD. FAHIM HOSSAIN — PERSONAL PORTFOLIO ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development or configure in Vercel.
# Never commit real API keys or secrets to version control.
# ==============================================================================

# 1. Production Canonical URL (Used for SEO canonical tags, Open Graph, sitemap.xml, robots.txt)
# Replace with your custom domain or Vercel deployment domain once live.
NEXT_PUBLIC_SITE_URL=https://fahim-portfolio.vercel.app

# 2. Server-Side Transactional Email Delivery (Resend)
# Get an API key at https://resend.com/api-keys
# Without RESEND_API_KEY, the contact API safely reports that server-side email is not configured yet
# and never fakes delivery success.
RESEND_API_KEY=

# Sender address configured in Resend:
# For testing before domain verification in Resend, you can use: onboarding@resend.dev
# After verifying your domain in Resend, use e.g.: contact@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Confirmed recipient inbox (Hardcoded fallback is fahimhossain1617@gmail.com; cannot be overridden by user input)
CONTACT_RECIPIENT_EMAIL=fahimhossain1617@gmail.com
